# frontend/.env.example
# Copy this file to frontend/.env and fill in real values.
# NEVER commit frontend/.env — it is gitignored.

# Mainnet GmonadWallCore contract address (set after deployment)
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# WalletConnect / Reown Cloud project ID
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Testnet archive — read-only, never written to
VITE_TESTNET_CONTRACT_ADDRESS_V1=0x0000000000000000000000000000000000000000
VITE_TESTNET_CONTRACT_ADDRESS_V2=0x0000000000000000000000000000000000000000
VITE_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
