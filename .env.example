# Root .env.example — Hardhat / deploy scripts
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.

# Deployer private key (used only for contract deployment)
PRIVATE_KEY=your_deployer_private_key_here

# Etherscan API key (used for contract verification on monadMainnet)
# Obtain from https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Admin owner address — receives contract ownership via transferOwnership() after deploy.
# Use a fresh dedicated wallet (hardware preferred). NOT a daily wallet.
# The private key for this address must NEVER be stored in this file or committed.
ADMIN_OWNER_ADDRESS=your_admin_wallet_address_here
